function isPositive(x: int): bool {
  return x > 0
}

function fact(n: int): int {
  if (n <= 1) {
    return 1
  }
  return n * fact(n - 1)
}

function fib(n: int): int {
  ff (n <= 1) {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}


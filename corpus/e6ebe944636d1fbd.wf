// Lines: 37.73% (1360/3605) Regions: 40.44%
function computeLoopControl(limit: int): int {
  var total = 0
  for (var i = 0; i < limit; i += 1) {
    if (i == 2) {
      continue
    }
    if (i == 6) {
      break
    }
    total += i
  }

  var count = 0
  do {
    count += 1
    if (count == 2) {
      continue
    }
    total += 10
  } while (count < 3)

  return total
}

computeLoopControl(10); index = 0; while (index < 2) { value ^= 2; index += 1 }

// Lines: 34.92% (1259/3605) Regions: 38.44%
function compute(start, limit) {
  value = start
  if (start < limit) {
    value = 4
  } else {
    value = 5
  }
  while (value < limit) {
    value += 1
  }
  for (index = 0; index < 3; index += 1) {
    value += 2
  }
  value
}

compute(0, 7); if (true) { b |= 7 } else { b -= 2 }
